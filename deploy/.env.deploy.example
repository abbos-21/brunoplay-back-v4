# deploy/.env — values for docker compose itself (the application's own settings are in ../.env)
POSTGRES_PASSWORD=

# How the API is reached from the internet:
#   nginx on the server (the usual shared-VPS setup): leave COMPOSE_PROFILES empty. The API listens on 127.0.0.1:API_PORT only.
#   Caddy (everything in Docker, nothing else on ports 80/443): COMPOSE_PROFILES=caddy and fill APP_DOMAIN / ADMIN_DOMAIN below.
COMPOSE_PROFILES=
API_PORT=8085
# the game and the admin panel: two names pointing at this server (DNS A records)
APP_DOMAIN=play.example.com
ADMIN_DOMAIN=admin.example.com
# where build-web.sh puts the built web apps
WWW_DIR=/opt/brunoplay/www
VERSION=
PG_SHARED_BUFFERS=512MB

# off-site backups (restic): a repository outside this server and a password file kept somewhere else too
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/root/.brunoplay-restic-password
# optional: how many days of WAL to keep on this server
WAL_KEEP_DAYS=14

# Copy to .env on the server and fill in. NEVER commit the real .env.
# dev | staging | production
APP_ENV=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://brunoplay:CHANGE_ME@postgres:5432/brunoplay?sslmode=disable
DB_MAX_CONNS=20

# long random secrets (>= 32 chars, different from each other): openssl rand -hex 32
JWT_SECRET=
ADMIN_JWT_SECRET=

# Telegram
BOT_TOKEN=
BOT_USERNAME=ImTomsBot
# random string; Telegram sends it back in a header
BOT_WEBHOOK_SECRET=
# the same address as APP_DOMAIN in deploy/.env
PUBLIC_API_URL=https://play.example.com
WEB_APP_URL=https://play.example.com

# Adsgram
ADSGRAM_WEBHOOK_SECRET=

# TON
TON_API_URL=https://toncenter.com/api/v2
TON_API_KEY=
# master switch for automatic TON payouts; keep false until the owner enables it
AUTO_PAYOUT=false
# only if AUTO_PAYOUT=true; secret store only
PAYOUT_WALLET_SEED=

# Alerts to a Telegram admin chat
ALERT_CHAT_ID=

# Web
CORS_ORIGINS=https://play.example.com,https://admin.example.com
# behind our own reverse proxy
TRUSTED_PROXY=true
INITDATA_MAX_AGE=24h
# must stay false in production (refused at start otherwise)
DEV_AUTH=false
LOG_LEVEL=info
